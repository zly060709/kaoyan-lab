 "questions": [
  {
   "id": "math2-2015-1",
   "subject": "math2",
   "year": 2015,
   "num": 1,
   "type": "single",
   "score": 4,
   "stem": "下列反常积分收敛的是（ ）",
   "options": [
    "（A）$\\int_{2}^{+\\infty}\\dfrac{1}{\\sqrt x}dx$",
    "（B）$\\int_{2}^{+\\infty}\\dfrac{\\ln x}{x}dx$",
    "（C）$\\int_{2}^{+\\infty}\\dfrac{1}{x\\ln x}dx$",
    "（D）$\\int_{2}^{+\\infty}\\dfrac{x}{e^{x}}dx$"
   ],
   "answer": "D",
   "source_blocks": [
    {
     "role": "analysis",
     "origin": "source",
     "text": "$\\int\\dfrac{x}{e^{x}}dx=-(x+1)e^{-x}$，则 $\\int_{2}^{+\\infty}\\dfrac{x}{e^{x}}dx=-(x+1)e^{-x}\\Big|_{2}^{+\\infty}=3e^{-2}-\\lim_{x\\to+\\infty}(x+1)e^{-x}=3e^{-2}$，收敛。而 (A) 发散（$p=\\frac12<1$）；(B) $\\int\\frac{\\ln x}{x}dx=\\frac12\\ln^2x\\to\\infty$ 发散；(C) $\\int\\frac{dx}{x\\ln x}=\\ln\\ln x\\to\\infty$ 发散。"
    },
    {
     "role": "approach",
     "origin": "extended",
     "text": "$p$-积分与对数积分的敛散门槛：$\\int^\\infty\\frac{dx}{x^p}$ 需 $p>1$；$\\frac{\\ln x}{x}$ 与 $\\frac{1}{x\\ln x}$ 都是「临界发散」；(D) 分母指数增长必收敛。"
    },
    {
     "role": "warn",
     "origin": "extended",
     "text": "易错：(C) 看似类似 $\\frac{1}{x\\ln^2x}$（收敛）——指数是 1 次时发散。"
    }
   ],
